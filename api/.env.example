# Copy to api/.env for running the API outside Docker (npm run dev).
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# Matches the postgres service in docker-compose.yml (port published on localhost:5432)
DATABASE_URL=postgresql://tesla:tesla@localhost:5432/tesla_pool?schema=public

# Used to sign login tokens. Use a long random string in any real environment.
JWT_SECRET=change-me-to-a-long-random-string
